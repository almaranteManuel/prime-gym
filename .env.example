# --- Postgres ---
POSTGRES_USER=primegym
POSTGRES_PASSWORD=cambiar_por_una_contraseña_fuerte
POSTGRES_DB=primegym

# --- Dominio de producción ---
# Caddy obtiene y renueva el certificado SSL automáticamente para este dominio
# (puertos 80 y 443 deben estar abiertos en el VPS).
# Mientras el DNS no apunte al VPS se puede probar con http://<IP_PUBLICA>,
# Caddy también sirve el tráfico que llega por IP en el puerto 80.
DOMAIN=gimnasio.tudominio.com

# --- Origen permitido por CORS ---
# Debe coincidir EXACTAMENTE con la URL desde la que entras al panel
# (esquema + host, sin barra final). Si no se define, compose usa https://<DOMAIN>.
# Durante pruebas con la IP pública (DNS sin propagar), descomentar y usar la IP:
# FRONTEND_URL=http://203.0.113.10

# --- Vercel + Neon (despliegue unificado costo $0) ---
# DATABASE_URL: URL POOLEADA de Neon (host con "-pooler", puerto 6543)
#   + ?pgbouncer=true&connection_limit=1&sslmode=require
#   Ej: postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL: URL DIRECTA de Neon (sin "-pooler", puerto 5432), solo migraciones.
#   Ej: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/db?sslmode=require
# En local/Docker DIRECT_URL puede ser igual a DATABASE_URL (compose ya lo define).
# JWT_SECRET: obligatorio. Generar con: openssl rand -base64 32
# JWT_EXPIRES_IN: ej. 2h
# DEFAULT_ADMIN_USERNAME / DEFAULT_ADMIN_PASSWORD: solo bootstrap inicial.
# NO definir VITE_API_URL en Vercel: el frontend usa /api relativo (mismo origen).

# --- Postgres ---
POSTGRES_USER=primegym
POSTGRES_PASSWORD=cambiar_por_una_contraseña_fuerte
POSTGRES_DB=primegym

# --- Dominio de producción ---
# Caddy obtiene y renueva el certificado SSL automáticamente para este dominio
# (puertos 80 y 443 deben estar abiertos en el VPS).
# Mientras el DNS no apunte al VPS se puede probar con http://<IP_PUBLICA>,
# Caddy también sirve el tráfico que llega por IP en el puerto 80.
DOMAIN=gimnasio.tudominio.com

# --- Origen permitido por CORS ---
# Debe coincidir EXACTAMENTE con la URL desde la que entras al panel
# (esquema + host, sin barra final). Si no se define, compose usa https://<DOMAIN>.
# Durante pruebas con la IP pública (DNS sin propagar), descomentar y usar la IP:
# FRONTEND_URL=http://203.0.113.10
